type hal_lineage_health_default, domain;
hal_server_domain(hal_lineage_health_default, hal_lineage_health)

type hal_lineage_health_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_lineage_health_default)

binder_call(hal_lineage_health_default, servicemanager);

# Qualcomm variant: battery/USB sysfs access
# (LOS official uses rw_dir_file() macro; trunk_staging dropped it and forbids
# write to sysfs dirs globally - read-only is all the health HAL needs)
allow hal_lineage_health_default sysfs_battery_supply:dir r_dir_perms;
allow hal_lineage_health_default sysfs_battery_supply:file r_file_perms;
allow hal_lineage_health_default sysfs_usb_supply:dir r_dir_perms;
allow hal_lineage_health_default sysfs_usb_supply:file r_file_perms;
